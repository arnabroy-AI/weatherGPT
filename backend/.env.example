# Copy to `.env` and fill in real keys. Never commit `.env`.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
WEATHER_API_KEY=your-imd-or-openweather-key-here

# Sarvam (Phase 9, D-06): multilingual translate plus voice (STT/TTS).
# Get a key from the Sarvam dashboard (https://dashboard.sarvam.ai) — see the
# API docs at https://docs.sarvam.ai. Never commit a real key: copy this file
# to `.env` and fill it in there.
SARVAM_API_KEY=your-sarvam-api-key-here

# Demo hardening (Phase 7, D-06). Empty CORS_ALLOW_ORIGINS means local-dev
# open (all origins); set a comma-separated exact-origin list to lock down.
CORS_ALLOW_ORIGINS=
CHAT_THROTTLE_PER_MIN=60

# FCM push (Phase 10): service-account JSON for FCM v1 sends.
# A missing file disables push cleanly; the file stays gitignored, never commit it.
FCM_SERVICE_ACCOUNT_FILE=fcm-service-account.json
